<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor-bin/phpunit/vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="bootstrap.php"
	colors="true"
	cacheDirectory=".phpunit.cache">
	<testsuites>
		<testsuite name="unit">
			<directory>Unit</directory>
		</testsuite>
		<!-- Needs a Nextcloud server checkout (NEXTCLOUD_SERVER_DIR); see
		     tests/Platform/CoreSearchTest.php. Kept apart so the unit suite
		     stays runnable against the OCP stubs alone. -->
		<testsuite name="platform">
			<directory>Platform</directory>
		</testsuite>
	</testsuites>
</phpunit>
