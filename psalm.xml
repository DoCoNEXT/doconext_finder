<?xml version="1.0"?>
<!--
  findUnusedBaselineEntry is off because one baseline serves several Nextcloud
  APIs. The CI matrix analyses every version info.xml claims, and an issue can
  legitimately exist on one and not the next: three MissingDependency entries
  that 33 and 34 need are absent on 35. With it on, the newest leg fails on
  entries the older legs still require, which says nothing about the code.
  The baseline therefore no longer shrinks by itself — prune it by hand when a
  leg reports something you know you fixed.
-->
<!--
  findUnusedCode is off. Its analysis runs on reachability — code counts as
  used when something Psalm sees calling it reaches it — and in a Nextcloud
  app almost every entry point is invisible to it: controllers are found by
  route attribute, listeners called by the event dispatcher, commands and
  jobs through info.xml, and the container builds every service. Whatever
  only such an entry point uses looks dead. Measured in Core: of 48 findings
  Psalm called certain, 31 were live code. It needs those entry points
  declared with @psalm-api before it is worth turning on.

  ensureOverrideAttribute is on. #[\Override] makes a method that no longer
  overrides anything fail loudly: without it, a parent method Nextcloud
  renames or removes turns ours into a new method nobody calls, and the
  behaviour just stops. PHP 8.2 ignores the attribute; the engine enforces it
  from 8.3.
-->
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="false"
    errorBaseline="tests/psalm-baseline.xml"
    phpVersion="8.2"
    findUnusedCode="false"
    ensureOverrideAttribute="true"
>
    <projectFiles>
        <directory name="lib" />
        <ignoreFiles>
            <directory name="vendor" />
            <directory name="vendor-bin" />
        </ignoreFiles>
    </projectFiles>
    <!-- Without this, psalm never reads vendor/nextcloud/ocp and every OCP
         class it meets is "undefined" — 168 phantom errors that say nothing
         about this app's code. -->
    <extraFiles>
        <directory name="vendor"/>
    </extraFiles>
    <!-- Nextcloud marks API it intends to remove with @deprecated, and Psalm
         reports using it as an INFO, which passes CI silently. Promote them:
         an app that keeps calling retired API only finds out on the server it
         was upgraded onto. `occ app:check-code`, which used to catch this, no
         longer exists as of Nextcloud 34, so this is the only net left. -->
    <issueHandlers>
        <DeprecatedClass errorLevel="error" />
        <DeprecatedConstant errorLevel="error" />
        <DeprecatedFunction errorLevel="error" />
        <DeprecatedInterface errorLevel="error" />
        <DeprecatedMethod errorLevel="error" />
        <DeprecatedProperty errorLevel="error" />
        <DeprecatedTrait errorLevel="error" />
    </issueHandlers>
</psalm>
