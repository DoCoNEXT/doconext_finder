{
  "name": "doconext_finder",
  "version": "0.9.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "DoCoNEXT",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "build": "vite build",
    "dev": "vite --mode development build",
    "watch": "vite --mode development build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit",
    "stylelint": "stylelint \"src/**/*.vue\" \"src/**/*.scss\" \"src/**/*.css\"",
    "prebuild": "node scripts/check-version.mjs"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.5.2",
    "@nextcloud/capabilities": "^1.2.0",
    "@nextcloud/dialogs": "^7.4.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.3.0",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "~9.13.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/vite-config": "^2.5.2",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.8"
  },
  "engines": {
    "node": "^24",
    "npm": ">=11"
  }
}
